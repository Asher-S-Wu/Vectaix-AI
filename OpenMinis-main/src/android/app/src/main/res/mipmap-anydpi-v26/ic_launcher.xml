<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer for Android 13+ Themed
         Icons. Same silhouette shared by all 3 activity-alias adaptive
         icons (auto / classic_light / classic_dark) — Themed Icons
         re-tints from one shape regardless of which alias is active. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
