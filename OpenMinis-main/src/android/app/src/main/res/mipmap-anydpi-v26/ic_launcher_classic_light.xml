<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_light" />
    <!-- [T-android-light-icon-preview-night-leak] The forced "Light" variant
         must use the LIGHT "M" artwork regardless of system theme. Previously
         it pointed at @mipmap/ic_launcher_foreground, which HAS night-qualified
         variants (mipmap-night-*dpi = the dark M, shared with the auto/dark
         icon). On a dark-mode device the resolver picked that night foreground,
         so a pinned Light icon (and its settings preview) darkened. Mirror the
         forced Dark variant: point at an always-light copy with no -night
         qualifier so Light stays light in both system modes. -->
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground_light"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer (see ic_launcher.xml). -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
