<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-shortcut-icons-blank: adaptive icon for the "camera_chat" app-icon
  shortcut. minSdk=26 so the adaptive form is sufficient (no pre-26
  fallback needed). Background reuses the launcher's @color/ic_launcher_
  background (light/dark variants); foreground is the Material glyph
  (@drawable/ic_shortcut_camera_chat) inset into the 66dp adaptive safe zone so
  the launcher's icon mask doesn't clip it. The previous bare 24dp vector
  with a ?attr tint rendered blank because the launcher process can't
  resolve the app's theme attributes — see ic_shortcut_camera_chat for the fix.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_shortcut_camera_chat"
            android:inset="28%" />
    </foreground>
</adaptive-icon>
