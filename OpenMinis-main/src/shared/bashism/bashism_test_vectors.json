{
  "schemaVersion": 1,
  "_comment": "Shared conformance vectors for BashismDetector on BOTH platforms (T-bash-on-demand). Each vector: {name, script, expect: [ruleName,...]}. expect is order-insensitive and must match EXACTLY the set of distinct rule names hit. The compat group MUST all yield zero hits — it encodes the on-device compatibility findings (bashism_test_report.md) and the F1 heredoc-body-stripping requirement.",
  "sHits": [
    { "name": "arith-if", "script": "count=6\nif (( count > 5 )); then\n  echo big\nfi", "expect": ["arith-command"] },
    { "name": "arith-standalone", "script": "(( x = x + 1 ))", "expect": ["arith-command"] },
    { "name": "compound-assign-num", "script": "total=0\ntotal+=3\necho $total", "expect": ["compound-assign"] },
    { "name": "compound-assign-str", "script": "s=\"a\"\ns+=\"b\"", "expect": ["compound-assign"] },
    { "name": "brace-range-num", "script": "for i in {1..5}; do echo $i; done", "expect": ["brace-range"] },
