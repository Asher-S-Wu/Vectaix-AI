    { "name": "pipe-amp", "script": "make |& tee build.log", "expect": ["pipe-amp"] },
    { "name": "local-opt", "script": "f() { local -x v=1; }", "expect": ["local-opt"] },
    { "name": "mapfile", "script": "mapfile -t lines < input.txt", "expect": ["mapfile"] },
    { "name": "readarray", "script": "readarray rows < data.txt", "expect": ["mapfile"] },
    { "name": "select-in", "script": "select opt in start stop; do echo $opt; done", "expect": ["select-in"] },
    { "name": "extglob", "script": "ls @(alpha|beta).txt", "expect": ["extglob"] },
