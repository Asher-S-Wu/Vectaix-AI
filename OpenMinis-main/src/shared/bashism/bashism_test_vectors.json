    { "name": "read-a", "script": "read -a parts", "expect": ["read-a"] },
    { "name": "coproc", "script": "coproc worker { sort; }", "expect": ["coproc"] },
    { "name": "bash-shebang", "script": "#!/usr/bin/env bash\necho hi", "expect": ["bash-shebang"] },
    { "name": "bash-invoke-pipe", "script": "curl -s https://example.com/x.sh | bash", "expect": ["bash-invoke"] },
    { "name": "bash-invoke-head", "script": "bash ./run.sh", "expect": ["bash-invoke"] },
    { "name": "bash-invoke-sudo", "script": "sudo bash -c 'id'", "expect": ["bash-invoke"] }
